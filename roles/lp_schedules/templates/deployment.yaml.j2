---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: linear-program
  namespace: lp-schedules
spec:
  replicas: 1
  selector:
    matchLabels:
      app: linear-program
  template:
    metadata:
      labels:
        app: linear-program
    spec:
      nodeSelector:
        role: server
      containers:
      - name: linear-program
        image: docker.io/library/linear-program:local
        imagePullPolicy: Never
        command:
          - python
          - /app/linear_program.py
          - --host
          - 0.0.0.0
          - --port
          - "49090"
          - --c_bat
          - "{{ battery_capacity_wh | default(500.0) }}"
          - --soc_min_wh
          - "{{ soc_min_wh | default(0.0) }}"
          - --soc_crit_wh
          - "{{ soc_crit_wh | default(100.0) }}"
          - --energy_scale
          - "{{ energy_scale | default(3.0) }}"
          - --c_base
          - "{{ static_energy_wh | default(124.0) }}"
          - "--force_max_solution={{ (lp_force_max_solution | default(false)) | ternary('true', 'false') }}"
          - "--force_min_solution={{ (lp_force_min_solution | default(false)) | ternary('true', 'false') }}"
        ports:
        - containerPort: 49090
          name: http
        resources:
          requests:
            memory: "256Mi"
            cpu: "50m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /healthz
            port: 49090
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /healthz
            port: 49090
          initialDelaySeconds: 5
          periodSeconds: 5

---
apiVersion: v1
kind: Service
metadata:
  name: linear-program
  namespace: lp-schedules
spec:
  type: NodePort
  selector:
    app: linear-program
  ports:
  - port: 49090
    targetPort: 49090
    nodePort: 30049
    name: http
